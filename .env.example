# Copy to .env and fill in. Placeholder values ("REPLACE_ME") are treated as unset.

# --- Google Places API (New) — used by `discover` only ---
# Requested fields (id, name, address, website, phone) bill as "Text Search Enterprise":
# 1,000 free requests/month, then US$35 per 1,000. Also set a daily quota cap in Google Cloud.
GOOGLE_PLACES_API_KEY=REPLACE_ME
# App-side hard limits on billable requests (each request returns up to 20 companies).
PLACES_MAX_REQUESTS_PER_RUN=10
PLACES_MAX_REQUESTS_PER_DAY=30
PLACES_MAX_REQUESTS_PER_MONTH=900

# --- Crawler ---
# Identify the bot honestly; add a contact URL/email once the sending domain exists.
CRAWL_USER_AGENT=LeadPipelineBot/0.1
CRAWL_DELAY_MS=2000
CRAWL_TIMEOUT_MS=15000
CRAWL_MAX_PAGES_PER_SITE=8
# Websites crawled in parallel (1-8). Each site still gets one request per CRAWL_DELAY_MS.
CRAWL_CONCURRENCY=4
CRAWL_MAX_BYTES=2000000
# Retry JavaScript-built sites (empty HTML shell, no contacts found) in headless Chromium.
# Needs: npx playwright install chromium
CRAWL_BROWSER_FALLBACK=true

# --- Storage ---
DATA_DIR=./data

# --- Email (stage 5+) ---
# test = every email goes ONLY to TEST_RECIPIENT (your own inbox), never to scraped contacts.
# Live sending is not implemented; it will require a separate sending domain and an explicit opt-in.
SEND_MODE=test
EMAIL_FROM=you@yourdomain.com
TEST_RECIPIENT=your-personal-inbox@example.com
TEST_SEND_MAX_PER_DAY=20
# Gmail sign-in: save the Desktop OAuth client JSON from Google Cloud as data/google-oauth-client.json.
# After "Connect Gmail", the access token is stored in data/google-token.json (never commit either file).

# --- LLM (used by `qualify`) ---
# Only "ollama" is implemented for now.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT_MS=180000
LLM_NUM_CTX=8192
